{
  "name": "builtlore",
  "version": "0.1.0-alpha.1",
  "description": "See how your app is actually built: business flows, data and history on one canvas, generated from code.",
  "type": "module",
  "bin": {
    "builtlore": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "scan:fixture": "npm run build && node dist/src/cli.js scan fixtures/laravel-clinic"
  },
  "keywords": [
    "documentation",
    "visualization",
    "business-process",
    "flowchart",
    "laravel",
    "codebase",
    "living-documentation",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "elkjs": "^0.12.1",
    "php-parser": "^3.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
